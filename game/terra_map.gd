class_name TerraMap
extends RefCounted

## The map of Terra on the bridge hall's sand table (基地建模改造案_v1 §八,
## 泰拉地理调研_v1.md). Places come from art/kit/textures/terra_map.json, in
## the community redraw's 0–1 coordinates; the table shows its `crop`.

const DATA := "res://art/kit/textures/terra_map.json"
## Where Rhodes Island is on a new save: off Lungmen, where the story begins.
const START := "龙门"

## Generated by make_terra_height.py: trees, cities and places in table metres.
const FEATURES := "res://art/kit/textures/base_terra_features.json"

static var _data := {}
static var _features := {}

static func features() -> Dictionary:
	if _features.is_empty():
		_features = JSON.parse_string(FileAccess.get_file_as_string(FEATURES))
	return _features

## A place on the relief, in the hall's axes about the map's centre (x west,
## y up from the table, z north), metres.
static func place_local(place: String) -> Vector3:
	var p: Array = features().places.get(place, features().places[START])
	return Vector3(p[0], p[1], p[2])

static func data() -> Dictionary:
	if _data.is_empty():
		_data = JSON.parse_string(FileAccess.get_file_as_string(DATA))
	return _data

static func has_place(place: String) -> bool:
	return data().nations.has(place)

## The place a field region's contracts are run from (mine -> 切尔诺伯格, ...).
static func place_for_region(region_id: String) -> String:
	return str(data().field_regions.get(region_id, START))

## A place on the table: 0–1 across the cropped map, x west→east, y north→south.
static func table_uv(place: String) -> Vector2:
	var p: Array = data().nations.get(place, data().nations[START])
	var crop: Array = data().crop
	return Vector2((float(p[0]) - crop[0]) / (crop[2] - crop[0]), (float(p[1]) - crop[1]) / (crop[3] - crop[1]))
